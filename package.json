{
  "name": "gs_mmh_web",
  "version": "0.0.1",
  "description": "The new Web-Site and App for the MachMit!Haus in Goslar",
  "main": "index.php",
  "scripts": {
    "serve": "concurrently \"npm run serve-php\" \"npm run sync\"",
    "serve-php": "composer start",
    "sync": "node browsersync.js",
    "format": "npm run format:js && npm run format:css && npm run format:php",
    "format:js": "prettier --write \"**/*.{js,ts,json}\"",
    "format:css": "prettier --write \"**/*.{css,scss}\"",
    "format:php": "ddev exec composer run format",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:php",
    "lint:js": "eslint -c eslint.config.js public/assets/js",
    "lint:js:fix": "eslint -c eslint.config.js public/assets/js --fix",
    "lint:css": "stylelint \"public/assets/**/*.css\"",
    "lint:css:fix": "stylelint \"public/assets/**/*.css\" --fix",
    "lint:php": "ddev exec composer run lint",
    "test:e2e": "playwright test smoke",
    "test:visual": "playwright test visual",
    "test:visual:update": "playwright test visual --update-snapshots",
    "test:tools": "node --test \"tests/tools/*.test.js\"",
    "pr-template": "node tests/tools/pr-template.js --write",
    "pr-template:check": "node tests/tools/pr-template.js --check",
    "pre-commit": "npm run format && npm run lint",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MachMitGoslar/GS_MMH_WEB.git"
  },
  "keywords": [
    "website",
    "kirby"
  ],
  "author": "MachMit!Goslar",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rangarius/GS_MMH_WEB/issues"
  },
  "homepage": "https://github.com/rangarius/GS_MMH_WEB#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "kirbyup": "^3.5.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "lint-staged": {
    "public/assets/js/*.js": [
      "npx prettier --write",
      "npx eslint --fix"
    ],
    "*.json": [
      "npx prettier --write"
    ],
    "public/**/*.{css,scss}": [
      "npx prettier --write",
      "npx stylelint --fix --allow-empty-input"
    ]
  }
}
